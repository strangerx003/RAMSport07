# RAMSport server-backed configuration.
#
# Every account, project, document, profile and module snapshot is stored on the
# server. Copy this file to `.env.local` for local development and set the same
# values in your hosting provider for production. Never commit `.env.local`.

# --- Storage ---------------------------------------------------------------
# MongoDB is the production store: it survives redeploys and works across
# multiple server instances. When it is unset the server falls back to a local
# JSON store under RAMSPORT_DATA_DIR. That fallback is fine for `next dev` or a
# single machine with a persistent disk, but it is NOT durable on serverless
# hosts such as Vercel.
# MONGODB_URI=mongodb+srv://user:password@cluster.example.net/ramsport
# MONGODB_DATABASE=ramsport
# RAMSPORT_DATA_DIR=C:\path\to\persistent\ramsport-data

# --- Sessions --------------------------------------------------------------
# Optional. At least 32 characters. When unset the server generates a random
# secret once and stores it in the database, so sessions survive restarts.
# Set an explicit value in production so every instance signs cookies the same
# way and rotating the secret invalidates all sessions.
# RAMSPORT_SESSION_SECRET=replace-with-at-least-32-random-characters
# RAMSPORT_TOKEN_ENCRYPTION_KEY=replace-with-a-separate-32-character-secret

# --- Invited cloud subscribers ---------------------------------------------
# Engineering file content for invited subscribers is stored in their own
# Google Drive or Microsoft OneDrive RAMSport folder. MongoDB stores only
# encrypted refresh tokens, cloud folder identifiers, invitations and audits.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# MICROSOFT_CLIENT_ID=
# MICROSOFT_CLIENT_SECRET=
# RESEND_API_KEY=
# RESEND_FROM=RAMSport <access@example.com>

# --- Cookies ---------------------------------------------------------------
# Optional override for the Secure cookie flag. By default it is enabled when
# the request arrives over HTTPS (directly or through a trusted proxy).
# RAMSPORT_COOKIE_SECURE=true

# --- Sign-in hint ----------------------------------------------------------
# Evaluation builds show a "Test access" card under the sign-in form with the
# built-in test/test account. Set to `off` for a public production build, then
# rebuild: NEXT_PUBLIC_* values are inlined at build time.
# NEXT_PUBLIC_SHOW_TEST_ACCESS=off

# --- Hosting ---------------------------------------------------------------
# Leave unset for a root-hosted deployment (Vercel, Render, a custom domain).
# NEXT_PUBLIC_BASE_PATH is only needed for a sub-path deployment and must be
# rebuilt after changing it.
# NEXT_PUBLIC_BASE_PATH=
